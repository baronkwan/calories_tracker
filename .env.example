# Cloudflare API Configuration — copy to .env and fill in real values
# NEVER commit .env

# Cloudflare API token (for wrangler deploys)
CLOUDFLARE_API_TOKEN=

# Worker ADMIN_KEY — must match `wrangler secret put ADMIN_KEY`
# Used by sync scripts to act as user 1 (admin routes)
ADMIN_KEY=

# BK's dashboard password — used by local test scripts (scripts/test-*.mjs)
BK_PASSWORD=
